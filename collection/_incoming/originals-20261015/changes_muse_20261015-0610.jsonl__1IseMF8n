{"ts": "2026-10-15T06:10:00Z", "by": "model:muse-spark", "entity": "specimen", "id": "C251", "op": "set", "field": "story", "old": "A 1984 1 dinar from Yugoslavia. The obverse shows SFRY arms (torch and wheat); the reverse shows big 1; bilingual ДИНАР / DINAR legend, date, beaded rim. Struck in brass.", "new": "A 1984 Yugoslav dinar — struck in the year Sarajevo hosted the Winter Olympics, four years after Tito's death left the federation drifting. The state emblem on the obverse, designed by Dragomir Mileusnić, still proclaimed 'Socialist Federal Republic of Yugoslavia' in both Cyrillic and Latin scripts. Over 172 million were minted, but runaway inflation was already devouring the hard dinar — within a few years it would be swept away entirely.", "source": "Numista N#2417 (Yugoslavia 1 dinar 1984, KM#59, 172,185,000 mintage, nickel-brass, Dragomir Mileusnić emblem)", "verified": false, "phase": 2, "confidence": "high", "provenance": {"model": "muse-spark", "prompt_version": "STORY-QUALITY-PASS@2026-10-15", "workflow": "phase2-research", "inputs": [{"file": "collection/specimens/YU.json"}], "run_id": "STORY-BATCH5-20261015"}}
{"ts": "2026-10-15T06:10:00Z", "by": "model:muse-spark", "entity": "specimen", "id": "C008", "op": "set", "field": "story", "old": "A 1968 0.5 franc from Switzerland. Standing Helvetia on the obverse, value in wreath on the reverse, engravers Antoine Bovy and Albert Walch. Struck in CuNi 75/25.", "new": "A 1968 Swiss half-franc with the standing Helvetia — a design essentially unchanged since 1875, one of the longest-running coin portraits in the world. Struck in copper-nickel at Bern, tens of millions with and without the B mint mark. It circulated in 1968, the year revolts shook Paris and Prague while neutral Switzerland watched from its Alpine calm.", "source": "Numista (Switzerland ½ franc 1968, KM#23a.1, 20M no-B / 44.92M B mintage, Helvetia standing)", "verified": false, "phase": 2, "confidence": "high", "provenance": {"model": "muse-spark", "prompt_version": "STORY-QUALITY-PASS@2026-10-15", "workflow": "phase2-research", "inputs": [{"file": "collection/specimens/CH.json"}], "run_id": "STORY-BATCH5-20261015"}}
