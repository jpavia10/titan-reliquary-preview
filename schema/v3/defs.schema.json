{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jpavia10.github.io/titan-reliquary-preview/schema/v3/defs.schema.json",
  "title": "Titan Reliquary collection schema v3",
  "description": "v3 = v2 + phase tiers. Every field path has a tier (schema/v3/field_tiers.json): phase1 (quick pass from a staging photo), phase2 (critical analysis from pro photos + cited sources), owner (only the owner writes it), system (only the pipeline writes it). New in v3: Specimen.research, Specimen.variety, Specimen.measured.die_axis_deg, Type.period, Type.ruler, Type.commemorates. Story may be written in Phase 1 (short, from the label/photo context) and refined later.",
  "$defs": {
    "Date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time"
    },
    "Iso2": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "Currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "Confidence": {
      "enum": [
        "low",
        "med",
        "high"
      ]
    },
    "Measurement": {
      "description": "A physical quantity that may be exact, approximate, or a range. Unit is implied by the field name (_g, _mm, _oz).",
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "approx": {
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "spec",
            "measured",
            "estimated"
          ]
        }
      },
      "additionalProperties": false
    },
    "Denomination": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Decimal face amount, 0.5 for a half. null when the coin has no numeric value (a named token)."
        },
        "unit": {
          "type": "string",
          "description": "Unit word as struck/commonly named: 'franc', 'euro cent', 'øre', '¢'."
        },
        "currency": {
          "oneOf": [
            {
              "$ref": "#/$defs/Currency"
            },
            {
              "type": "null"
            }
          ]
        },
        "named": {
          "type": [
            "string",
            "null"
          ],
          "description": "Popular name when it differs: 'Roosevelt', 'threepence', 'Balanza'."
        },
        "display": {
          "type": [
            "string",
            "null"
          ],
          "description": "Manual override when the auto-formatter cannot express it. Use sparingly; every use is reported."
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "CatalogRef": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "description": "KM (Krause), Y (Yeoman), Schön, JNDA, Sp (Spink), N (Numista), PCGS, CoinFacts ..."
        },
        "number": {
          "type": "string"
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "system",
        "number"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "description": "One year (and mint) of a Type. Mintage and varieties live here, not on the specimen.",
      "type": "object",
      "properties": {
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "qualifier": {
          "enum": [
            null,
            "circa",
            "ND",
            "unparsed"
          ]
        },
        "decade": {
          "type": "boolean"
        },
        "calendar": {
          "type": "string",
          "description": "Non-Gregorian calendar the coin is dated in: AH, SE, BE, ROC ..."
        },
        "calendar_year": {
          "type": "integer"
        },
        "mint_marks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mint_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mint name / location / where the mark sits. Free text until the mint table is curated."
        },
        "mintage": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mintage_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "varieties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "desc": {
                "type": "string"
              },
              "key": {
                "type": "boolean"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "year",
        "mint_marks"
      ],
      "additionalProperties": false
    },
    "Type": {
      "description": "What a coin IS: the catalogue type. Written once, shared by every specimen of it.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2}(-[A-Z0-9]+)?\\.[A-Za-z]+\\.[\\w.\\-]+$",
          "description": "{ISSUER}.{catalog system}.{number}, e.g. CH.KM.24a.1; fallback ISO.X.denomination-slug"
        },
        "country": {
          "$ref": "#/$defs/Iso2"
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Issuer id when it is not simply the country (see ref/issuers)."
        },
        "class": {
          "enum": [
            "coin",
            "token",
            "medal",
            "prop",
            "note",
            "stamp",
            "other"
          ]
        },
        "denomination": {
          "$ref": "#/$defs/Denomination"
        },
        "catalogs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogRef"
          }
        },
        "composition": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "metal_class": {
              "enum": [
                "gold",
                "silver",
                "platinum",
                "palladium",
                "copper",
                "bronze",
                "brass",
                "nickel",
                "cupronickel",
                "aluminum",
                "steel",
                "plated steel",
                "zinc",
                "iron",
                "clad",
                "bimetallic",
                "other"
              ]
            },
            "fineness": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "text",
            "metal_class"
          ],
          "additionalProperties": false
        },
        "nominal": {
          "description": "Catalogue specification. Measured values on a real piece live on the specimen.",
          "type": "object",
          "properties": {
            "weight_g": {
              "type": [
                "number",
                "null"
              ]
            },
            "weight_approx": {
              "type": "boolean"
            },
            "weight_min_g": {
              "type": [
                "number",
                "null"
              ],
              "description": "Lower bound when the catalogue/ledger gives a range (then weight_g is null)."
            },
            "weight_max_g": {
              "type": [
                "number",
                "null"
              ]
            },
            "diameter_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "diameter_approx": {
              "type": "boolean"
            },
            "diameter_min_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "diameter_max_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "thickness_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "edge": {
              "type": [
                "string",
                "null"
              ]
            },
            "shape": {
              "type": [
                "string",
                "null"
              ]
            },
            "alignment": {
              "enum": [
                null,
                "coin",
                "medal"
              ]
            }
          },
          "additionalProperties": false
        },
        "precious": {
          "type": "object",
          "properties": {
            "asw_oz": {
              "type": [
                "number",
                "null"
              ]
            },
            "agw_oz": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "design": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "obverse": {
              "type": [
                "string",
                "null"
              ]
            },
            "reverse": {
              "type": [
                "string",
                "null"
              ]
            },
            "designers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "legend": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "legal_tender": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "current",
                "demonetized",
                "withdrawn",
                "superseded",
                "none",
                "unknown"
              ]
            },
            "until": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "TIER 2. Series memberships (e.g. 'Statehood quarters')."
        },
        "population": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "pcgs": {
              "type": [
                "integer",
                "null"
              ]
            },
            "ngc": {
              "type": [
                "integer",
                "null"
              ]
            },
            "as_of": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Date"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "description": "TIER 2. Third-party grading population counts."
        },
        "price_guide": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "value_usd": {
              "type": [
                "number",
                "null"
              ]
            },
            "grade": {
              "type": [
                "string",
                "null"
              ]
            },
            "date": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Date"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "description": "TIER 2. A dated price-guide figure with its source."
        },
        "die_variety": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "system": {
              "type": "string",
              "description": "VAM, Cherrypicker, FS, WEX..."
            },
            "code": {
              "type": "string"
            },
            "desc": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "description": "TIER 2."
        },
        "error_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "TIER 2. Mint error class (off-center, doubled die...)."
        },
        "rarity_scale": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "system": {
              "type": "string",
              "description": "Sheldon, Universal (R-1..R-8), Numista..."
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "TIER 2."
        },
        "related_types": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "TIER 2. Type ids of related types."
        },
        "image_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "TIER 2. A reference image (not one of the owner's photos)."
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "description": "PHASE 2. Historical period / regime, e.g. 'Weimar Republic', 'Showa era'."
        },
        "ruler": {
          "type": [
            "string",
            "null"
          ],
          "description": "PHASE 2. Ruler or authority named on or responsible for the coin, e.g. 'Elizabeth II'."
        },
        "commemorates": {
          "type": [
            "string",
            "null"
          ],
          "description": "PHASE 2. What a commemorative issue commemorates; null for circulation types."
        }
      },
      "required": [
        "id",
        "country",
        "class",
        "denomination",
        "composition",
        "issues"
      ],
      "additionalProperties": false
    },
    "Condition": {
      "type": "object",
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Plain-language state as recorded ('circulated', 'toned')."
        },
        "grade": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sheldon or descriptive: 'MS-65', 'VF-30', 'AU'."
        },
        "grader": {
          "enum": [
            null,
            "self",
            "PCGS",
            "NGC",
            "ANACS",
            "ICG",
            "CACG",
            "other"
          ]
        },
        "cert": {
          "type": [
            "string",
            "null"
          ],
          "description": "Third-party certification number."
        },
        "strike": {
          "type": [
            "string",
            "null"
          ]
        },
        "luster": {
          "type": [
            "string",
            "null"
          ]
        },
        "toning": {
          "type": [
            "string",
            "null"
          ]
        },
        "cleaned": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "damage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Specimen": {
      "description": "One physical piece the owner holds. Permanent key `id` never changes; `ser` is the reassignable display ID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]\\d{3,}$"
        },
        "ser": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(AF|AN|AS|EU|NA|OC|SA)-[A-Z0-9]{2,3}-\\d{3}$"
        },
        "type": {
          "type": "string"
        },
        "issue": {
          "$ref": "#/$defs/Issue"
        },
        "year_raw": {
          "type": "string",
          "description": "The year exactly as recorded, kept for audit."
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "measured": {
          "type": "object",
          "properties": {
            "weight_g": {
              "type": [
                "number",
                "null"
              ]
            },
            "diameter_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "thickness_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "magnetic": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "die_axis_deg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 360,
              "description": "PHASE 2. Measured die axis in degrees (0 = medal, 180 = coin alignment)."
            }
          },
          "additionalProperties": false
        },
        "housing": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                null,
                "flip_2x2",
                "slab",
                "tube",
                "album",
                "capsule",
                "box",
                "pouch",
                "loose",
                "other"
              ]
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "location": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "container": {
                  "type": "string"
                },
                "page": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "slot": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "acquisition": {
          "type": "object",
          "properties": {
            "logged_at": {
              "$ref": "#/$defs/Date"
            },
            "acquired_on": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "price_paid_usd": {
              "type": [
                "number",
                "null"
              ]
            },
            "family": {
              "type": [
                "string",
                "null"
              ],
              "description": "Who it came from or is associated with (family attribution)."
            }
          },
          "required": [
            "logged_at"
          ],
          "additionalProperties": false
        },
        "value": {
          "type": "object",
          "properties": {
            "est_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "confidence": {
              "$ref": "#/$defs/Confidence"
            },
            "face": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "currency": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Currency"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "Logged",
                "Photographed",
                "Verified",
                "Removed"
              ]
            },
            "removed_on": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "removed_reason": {
              "enum": [
                null,
                "sold",
                "traded",
                "gifted",
                "culled",
                "lost"
              ]
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "story": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1200,
          "description": "A short narrative for this piece (what it is, where it comes from, why it is interesting). Allowed from Phase 1 (2-4 sentences, plain facts visible or well known; no invented history). The owner's own words always win: an owner-verified story is never overwritten without 'supersedes'."
        },
        "ledger_text": {
          "type": [
            "object",
            "null"
          ],
          "description": "Ledger v254 wording kept verbatim where the website's display string cannot be derived from the structured facts (FX/demonetised note on the face value, catalogue and spec tails, label and denomination flourishes, frozen photo-name stem). The app build shows a value here instead of the derived string. Formatting only: never a source of facts; clear a key when the structured fact it shadows is corrected.",
          "properties": {
            "label": {
              "type": "string"
            },
            "face": {
              "type": "string"
            },
            "face_line": {
              "type": "string"
            },
            "metal": {
              "type": "string"
            },
            "refs": {
              "type": "string"
            },
            "specs": {
              "type": "string"
            },
            "specs_tail": {
              "type": "string",
              "description": "ledger remark appended after the derived thickness/alignment text"
            },
            "denom": {
              "type": "string"
            },
            "cat": {
              "type": "string"
            },
            "photo_stem": {
              "type": "string"
            },
            "mint": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Photo ids (see Photo)."
        },
        "serial_number": {
          "type": [
            "string",
            "null"
          ],
          "description": "Printed serial of a note or prop note. null for coins."
        },
        "seller_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "TIER 2. dealer, auction, private, gift, inheritance, found..."
        },
        "invoice_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "TIER 2."
        },
        "provenance_chain": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "properties": {
              "holder": {
                "type": "string"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "holder"
            ],
            "additionalProperties": false
          },
          "description": "TIER 2. Ordered previous holders."
        },
        "insurance": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "covered": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "appraised_value_usd": {
              "type": [
                "number",
                "null"
              ]
            },
            "appraised_on": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "appraiser": {
              "type": [
                "string",
                "null"
              ]
            }
